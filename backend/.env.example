APP_NAME=NomadAI Backend
DEBUG=False

POSTGRES_DB=nomadai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5433
APP_PUBLISHED_PORT=8000

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nomadai

JWT_SECRET_KEY=supersecretkey
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
# Optional: set AI_PROVIDER=groq and provide GROQ_API_KEY to use Groq instead.
GROQ_API_KEY=
GOOGLE_MAPS_API_KEY=your google api key
PEXELS_API_KEY=your pexels api key
OFFERS_ENABLED=false
OFFERS_DEMO_MODE=false
OFFERS_PROVIDER_TIMEOUT_SECONDS=8

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=adminpassword
ADMIN_FIRST_NAME=Amin
ADMIN_LAST_NAME=Soltobekov
